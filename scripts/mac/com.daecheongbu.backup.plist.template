<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  매일 백업 — LaunchAgent(사용자 권한). 윈도우 작업 「대청부 백업」(03:00)의 자리.
  하루 한 번 돌고 끝나는 일이라 KeepAlive 를 두지 않는다 — 실패했다고 다시 돌면
  같은 새벽에 판이 여럿 생긴다(윈도우 안내서 8-2 가 「다시 시작」 을 앱에만 둔 까닭).
  __REPO__ 는 scripts/mac/plist-만들기.sh 가 채운다. **3단계에서는 로드하지 않는다.**
  잠들어 있던 사이의 3시는 깨어난 뒤 한 번 돌지만, **꺼져 있던 사이의 3시는 건너뛴다.**
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daecheongbu.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/mac/백업.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <!-- data/launchd-*.log 라 로그밀기.sh 가 민다 -->
  <key>StandardOutPath</key>
  <string>__REPO__/data/launchd-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/launchd-backup.log</string>
</dict>
</plist>
