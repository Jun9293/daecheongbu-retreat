# scripts/mac/serve.sh 가 읽는 설정 — 이 파일을 .env 로 복사해 씁니다.
#   cp .env.example .env && chmod 600 .env
# .env 는 저장소에 안 올라갑니다(.gitignore). 값은 여기 적지 않습니다.
# 비워 둔 줄은 앱의 기본값을 씁니다. 이미 환경에 있는 값이 이깁니다(이름만 알립니다).
#
# **주석은 따로 한 줄에 적습니다.** `이름=값  # 설명` 처럼 값 뒤에 붙이면
# serve.sh 가 떼어 내고 줄 번호로 알립니다 — 값에 # 이 필요하면 따옴표로 감쌉니다.

# ── serve.sh 만 쓰는 것 ──
# DCB_PORT=8000
# DCB_LOG_FILE=
# DCB_LOG_MAX_BYTES=5242880

# ── 앱이 읽는 것 (docs/맥-이전.md 2장) ──
# DCB_DATA_DIR=
# DCB_BASE_URL=
# DCB_PUSH_CONTACT=
# 비밀값은 비워 두면 data/secret_key.txt · data/anthropic_key.txt 를 씁니다
# DCB_SECRET_KEY=
# DCB_ANTHROPIC_KEY=
